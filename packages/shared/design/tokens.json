{
  "$description": "Design Sheet „Hallenlicht“ (docs/DESIGN.md). Single source of truth – run `pnpm tokens` after editing.",
  "color": {
    "$type": "color",
    "navy-950": { "$value": "#0B1426", "$description": "Halle bei Nacht" },
    "navy-900": { "$value": "#0E1B33", "$description": "Netzband, Text" },
    "navy-800": { "$value": "#13203A", "$description": "Fläche dunkel" },
    "navy-850": { "$value": "#0F1A30", "$description": "vertiefte Fläche dunkel" },
    "navy-700": { "$value": "#1D3461", "$description": "Primärflächen" },
    "navy-500": { "$value": "#2F5596", "$description": "Links, Fokus-Begleitfarbe" },
    "navy-300": { "$value": "#7FA6E8", "$description": "Links im Dark Mode" },
    "navy-200": { "$value": "#A9C4F0", "$description": "Hover von navy-300" },
    "ball-500": { "$value": "#F2B705", "$description": "Ball-Gelb gedrückt/hover" },
    "ball-400": { "$value": "#FFC93C", "$description": "Ball-Gelb (Akzent)" },
    "ball-200": { "$value": "#FFE7A3", "$description": "Gelb, weich" },
    "floor-50": { "$value": "#F7F3EA", "$description": "Ahorn-Hallenboden" },
    "floor-100": { "$value": "#EFE8DA", "$description": "vertiefte Fläche hell" },
    "court-500": { "$value": "#E46A3C", "$description": "Spielfeld-Orange, nur dekorativ" },
    "slate-600": { "$value": "#5B6475", "$description": "Sekundärtext hell" },
    "slate-400": { "$value": "#9AA6BC", "$description": "Sekundärtext dunkel" },
    "line-light": { "$value": "#D9D1C0", "$description": "Feldlinie hell" },
    "line-dark": { "$value": "#24324F", "$description": "Feldlinie dunkel" },
    "chalk": { "$value": "#EEF2F8", "$description": "Text dunkel" },
    "white": { "$value": "#FFFFFF" },
    "green-700": { "$value": "#1B7A4E", "$description": "gehalten hell" },
    "green-300": { "$value": "#5FD39A", "$description": "gehalten dunkel" },
    "red-700": { "$value": "#B8452B", "$description": "nicht gehalten hell" },
    "red-300": { "$value": "#FF8A6B", "$description": "nicht gehalten dunkel" },
    "navy-950-a60": { "$value": "#0B142699", "$description": "navy-950 / 60 % (Backdrop)" }
  },
  "theme": {
    "$description": "Semantic tokens per mode. Components use only these.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.floor-50}" },
      "surface": { "$value": "{color.white}" },
      "surface-sunken": { "$value": "{color.floor-100}" },
      "text": { "$value": "{color.navy-900}" },
      "text-muted": { "$value": "{color.slate-600}" },
      "line": { "$value": "{color.line-light}" },
      "line-strong": {
        "$value": "{color.slate-600}",
        "$description": "Rahmen von Eingabefeldern (≥ 3:1, WCAG 1.4.11)"
      },
      "primary": { "$value": "{color.navy-700}" },
      "primary-hover": { "$value": "{color.navy-900}" },
      "on-primary": { "$value": "{color.white}" },
      "accent": { "$value": "{color.ball-400}" },
      "accent-hover": { "$value": "{color.ball-500}" },
      "on-accent": { "$value": "{color.navy-900}" },
      "accent-soft": { "$value": "{color.ball-200}" },
      "link": { "$value": "{color.navy-500}" },
      "focus-outer": { "$value": "{color.ball-400}" },
      "focus-inner": { "$value": "{color.navy-900}" },
      "held": { "$value": "{color.green-700}" },
      "not-held": { "$value": "{color.red-700}" },
      "pending": { "$value": "{color.ball-400}" },
      "on-pending": { "$value": "{color.navy-900}" },
      "planned": { "$value": "{color.navy-500}" },
      "cancelled": { "$value": "{color.slate-600}" },
      "danger": { "$value": "{color.red-700}" },
      "on-danger": { "$value": "{color.white}" },
      "scoreboard": { "$value": "{color.navy-900}" },
      "on-scoreboard": { "$value": "{color.white}" },
      "scoreboard-muted": { "$value": "{color.slate-400}" },
      "scoreboard-line": { "$value": "{color.line-dark}" },
      "progress": { "$value": "{color.navy-300}" },
      "court": { "$value": "{color.court-500}" },
      "overlay": { "$value": "{color.navy-950-a60}" },
      "qr-bg": { "$value": "{color.white}" },
      "paper": { "$value": "{color.white}", "$description": "Antrag-Vorschau: immer ein weißes Blatt" },
      "on-paper": { "$value": "{color.navy-900}" },
      "paper-line": { "$value": "{color.slate-600}" },
      "alarm-bg": { "$value": "{color.navy-950}" },
      "alarm-text": { "$value": "{color.white}" },
      "alarm-muted": { "$value": "{color.slate-400}" },
      "alarm-accent": { "$value": "{color.ball-400}" },
      "alarm-on-accent": { "$value": "{color.navy-950}" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "{color.navy-950}" },
      "surface": { "$value": "{color.navy-800}" },
      "surface-sunken": { "$value": "{color.navy-850}" },
      "text": { "$value": "{color.chalk}" },
      "text-muted": { "$value": "{color.slate-400}" },
      "line": { "$value": "{color.line-dark}" },
      "line-strong": { "$value": "{color.slate-400}" },
      "primary": {
        "$value": "{color.navy-300}",
        "$description": "Abweichung von DESIGN.md (ball-400): sonst mehrere gelbe Elemente pro Viewport, siehe DECISIONS.md"
      },
      "primary-hover": { "$value": "{color.navy-200}" },
      "on-primary": { "$value": "{color.navy-950}" },
      "accent": { "$value": "{color.ball-400}" },
      "accent-hover": { "$value": "{color.ball-500}" },
      "on-accent": { "$value": "{color.navy-950}" },
      "accent-soft": { "$value": "{color.navy-800}" },
      "link": { "$value": "{color.navy-300}" },
      "focus-outer": { "$value": "{color.ball-400}" },
      "focus-inner": { "$value": "{color.navy-950}" },
      "held": { "$value": "{color.green-300}" },
      "not-held": { "$value": "{color.red-300}" },
      "pending": { "$value": "{color.ball-400}" },
      "on-pending": { "$value": "{color.navy-950}" },
      "planned": { "$value": "{color.navy-300}" },
      "cancelled": { "$value": "{color.slate-400}" },
      "danger": { "$value": "{color.red-300}" },
      "on-danger": { "$value": "{color.navy-950}" },
      "scoreboard": { "$value": "{color.navy-800}" },
      "on-scoreboard": { "$value": "{color.chalk}" },
      "scoreboard-muted": { "$value": "{color.slate-400}" },
      "scoreboard-line": { "$value": "{color.line-dark}" },
      "progress": { "$value": "{color.navy-300}" },
      "court": { "$value": "{color.court-500}" },
      "overlay": { "$value": "{color.navy-950-a60}" },
      "qr-bg": { "$value": "{color.white}" },
      "paper": { "$value": "{color.white}", "$description": "Antrag-Vorschau: immer ein weißes Blatt" },
      "on-paper": { "$value": "{color.navy-900}" },
      "paper-line": { "$value": "{color.slate-600}" },
      "alarm-bg": { "$value": "{color.navy-950}" },
      "alarm-text": { "$value": "{color.white}" },
      "alarm-muted": { "$value": "{color.slate-400}" },
      "alarm-accent": { "$value": "{color.ball-400}" },
      "alarm-on-accent": { "$value": "{color.navy-950}" }
    }
  },
  "series": {
    "$type": "color",
    "$description": "Farben, die Nutzer für Serien wählen können (Datenwerte, gespeichert als Hex).",
    "navy": { "$value": "{color.navy-500}" },
    "green": { "$value": "{color.green-700}" },
    "court": { "$value": "{color.court-500}" },
    "plum": { "$value": "#7A4FB5" },
    "teal": { "$value": "#1F7F8C" },
    "ochre": { "$value": "#A8790A" },
    "slate": { "$value": "{color.slate-600}" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif-condensed", "sans-serif"] },
      "sans": { "$value": ["Barlow", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.375rem" },
      "2xl": { "$value": "1.75rem" },
      "3xl": { "$value": "2.25rem" },
      "display": { "$value": "clamp(3rem, 2.25rem + 3vw, 4.5rem)" }
    },
    "leading": {
      "$type": "number",
      "text": { "$value": 1.5 },
      "display": { "$value": 1.05 }
    },
    "tracking": {
      "$type": "dimension",
      "label": { "$value": "0.06em" }
    }
  },
  "space": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "4-px-Raster; Tailwind-Utilities p-1 … p-16" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "48px" },
    "content": { "$value": "1120px" },
    "form": { "$value": "560px" },
    "rail": { "$value": "72px" },
    "sidebar": { "$value": "240px" },
    "fab": { "$value": "56px" },
    "button-sm": { "$value": "40px" },
    "button-md": { "$value": "48px" },
    "button-lg": { "$value": "56px" },
    "button-xl": { "$value": "72px" },
    "alarm-yes": { "$value": "72px" },
    "alarm-no": { "$value": "64px" },
    "alarm-later": { "$value": "48px" },
    "chip": { "$value": "48px" },
    "line": { "$value": "1.5px", "$description": "Feldlinie" },
    "mark": { "$value": "8px", "$description": "Mittelmarke der Feldlinie" },
    "stripe": { "$value": "4px", "$description": "Status-Streifen links" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "float": {
      "$value": { "color": "#0E1B3324", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "icon": {
    "$type": "dimension",
    "sm": { "$value": "16px" },
    "md": { "$value": "20px" },
    "lg": { "$value": "24px" },
    "stroke": { "$value": "1.75" }
  }
}
