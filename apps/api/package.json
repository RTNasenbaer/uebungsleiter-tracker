{
  "name": "@ult/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types --include-runtime false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@ult/shared": "workspace:*",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261101.0",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.162.0"
  }
}
