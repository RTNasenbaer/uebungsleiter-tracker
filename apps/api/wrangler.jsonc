// SPDX-License-Identifier: AGPL-3.0-or-later
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uebungsleiter-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uebungsleiter-tracker",
      // Replaced by the deploy workflow with the real id (see .github/workflows/deploy.yml).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "ENABLE_TEST_ROUTES": "false",
    "APP_ORIGIN": "",
    "SOURCE_URL": "https://github.com/RTNasenbaer/uebungsleiter-tracker",
  },
  // Secrets (wrangler secret / GitHub Actions): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, ALLOWED_GITHUB_IDS
}
