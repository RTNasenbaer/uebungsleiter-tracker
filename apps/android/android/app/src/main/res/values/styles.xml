<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later – colors/dimens come from the generated token resources (pnpm tokens) -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hl_primary</item>
        <item name="colorPrimaryDark">@color/hl_bg</item>
        <item name="colorAccent">@color/hl_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/hl_bg</item>
        <item name="android:statusBarColor">@color/hl_bg</item>
        <item name="android:navigationBarColor">@color/hl_surface</item>
        <item name="android:windowLightStatusBar">@bool/hl_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/hl_light_bars</item>
    </style>

    <!-- Splash (core-splashscreen): navy-950 with the centred ball logo (DESIGN.md §13) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AlarmTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hl_alarm_accent</item>
        <item name="android:windowBackground">@color/hl_alarm_bg</item>
        <item name="android:statusBarColor">@color/hl_alarm_bg</item>
        <item name="android:navigationBarColor">@color/hl_alarm_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="AlarmText">
        <item name="android:textColor">@color/hl_alarm_text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="AlarmText.Label">
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/hl_alarm_muted</item>
    </style>

    <style name="AlarmText.Date">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">@dimen/hl_text_2xl</item>
    </style>

    <style name="AlarmText.Time">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">@dimen/hl_text_display</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">40sp</item>
        <item name="android:autoSizeMaxTextSize">@dimen/hl_text_display</item>
    </style>

    <style name="AlarmText.Muted">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">@dimen/hl_text_lg</item>
        <item name="android:textColor">@color/hl_alarm_muted</item>
    </style>

    <style name="AlarmText.Question">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">@dimen/hl_text_3xl</item>
    </style>

    <style name="AlarmButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">@dimen/hl_text_xl</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/hl_radius_sm</item>
    </style>

    <style name="AlarmButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">@dimen/hl_text_xl</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/hl_alarm_text</item>
        <item name="strokeColor">@color/hl_alarm_text</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">@dimen/hl_radius_sm</item>
    </style>

    <style name="AlarmButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">@dimen/hl_text_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/hl_alarm_muted</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
