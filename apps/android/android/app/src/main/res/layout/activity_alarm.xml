<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/alarm_text"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/alarm_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="@color/alarm_text_muted"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_yes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:text="@string/alarm_yes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:backgroundTint="@color/alarm_yes"
            app:cornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="88dp"
            android:text="@string/alarm_no"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:backgroundTint="@color/alarm_no"
            app:cornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:textAllCaps="false"
            android:textColor="@color/alarm_later_text"
            android:textSize="20sp"
            app:backgroundTint="@color/alarm_later_bg"
            app:cornerRadius="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <EditText
            android:id="@+id/alarm_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:autofillHints=""
            android:hint="@string/alarm_note_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="500"
            android:minHeight="56dp"
            android:textColor="@color/alarm_text"
            android:textColorHint="@color/alarm_text_muted" />
    </LinearLayout>
</ScrollView>
