  "env": {
    "TZ": "Europe/Berlin",
    "PLAYWRIGHT_HTML_OPEN": "never",
    "WRANGLER_SEND_METRICS": "false"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && [ -f node_modules/.bin/prettier ] && node_modules/.bin/prettier --write --ignore-unknown \"$f\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
